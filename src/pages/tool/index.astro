---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tools = [
  {
    href: "/tool/json",
    name: "JSON 格式化",
    description: "美化、压缩、添加与去除转义，支持紧凑数组单行显示。",
  },
  {
    href: "/tool/logview",
    name: "日志格式化查看",
    description: "自动解转义、识别行内 JSON 与日志级别，友好展示。",
  },
  {
    href: "/tool/unixtimestamp",
    name: "Unix 时间戳",
    description: "自动识别时间戳、日期、时间，统一按北京时间展示。",
  },
];
---

<BaseLayout title="工具" description="纯前端的个人常用工具：JSON 格式化、日志格式化查看、Unix 时间戳。">
  <div class="page-shell tool-index-page">
    <header class="page-header">
      <p class="eyebrow">TOOLS</p>
      <h1>常用工具</h1>
      <p>所有工具均在浏览器本地运行，输入内容不会离开当前设备。</p>
    </header>
    <div class="tool-grid">
      {
        tools.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <h2>{tool.name}</h2>
            <p>{tool.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
